// // Example 2: Driven Purely from a Procedural Block (4-to-1 mux)

// // make multiplex 4:1
module tab;
  logic [7:0] a,b,c,d;
  logic [1:0] select_signal;
  logic [7:0] out;
  
  always_comb begin
    case(select_signal)
      2'b00 : out = a;
      2'b01 : out = b;
      2'b10 : out = c;
      2'b11 : out = d;
    endcase
  end
  
  initial begin
TESTCASE
    a= 8'hac; b=8'hcd; c=8'h11; d=8'h87;
// question:- Why can $display still see X?

//Because the testbench initial block and always_comb are both processes scheduled in the Active region. 
//The simulator does not guarantee which active process executes first.
    select_signal=2'b00;     #1;
    $display("select=%b out=%0h", select_signal, out);

    select_signal=2'b01; #1;
    $display("select=%b out=%0h", select_signal, out);
    
      select_signal=2'b10; #1;
    $display("select=%b out=%0h", select_signal, out);
    
      select_signal=2'b11; #1;  // why  we take delay  and why without delay it's give x output
    $display("select=%b out=%0h", select_signal, out);
    
  end
    
  
endmodule 
//issue:-

//“initial and always_comb are concurrent processes. When select_signal changes,
//always_comb is triggered. Both are scheduled in the Active region, and the simulator does not guarantee their execution order. 
//Therefore, $display may execute before always_comb updates out, so it can print X.”
              ACTIVE REGION
                    |
          ┌─────────┴─────────┐
          ↓                   ↓
      initial block       always_comb
          |                   |
          |                   |
select = 00             triggered by
          |              select change
          |
     $display(out)
          |
          ↓
          X
                              |
                              ↓
                           out = a
                              |
                              ↓
                           out = AC
