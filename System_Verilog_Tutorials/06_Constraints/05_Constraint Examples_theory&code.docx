//------------------------------------------------------------//Weighted Distributions
//1. := Operator :- gives every listed value in a range that same weight individually
//key:- dist
//:/ splits a weight evenly across the values in a range.
// class packet;
//   rand bit[2:0]min;
  
//   // := 
//   //20 + (5×50) + 40 + 10 = 320. The probability of choosing 0 is 20/320, and the combined probability of landing anywhere between 1 and 5 is 250/320
  
// //  constraint x{ min dist{ 0:=20, [2:6]:=50, 1:=40, 7:=20};}
  
// //:/ Operator
//   //20 + 50 + 40 + 10 = 120. The probability of choosing 6 is 40/120, the highest of any single value, and the probability of choosing 0 is 20/120
//   constraint x{ min dist{ 0:/20, [2:6]:/50, 1:/40, 7:/20};}

 

