//Bidirectional Constraints 

class packet;
  rand bit[3:0]min;
  
  constraint x{ min> 2; min <12; }

  constraint jh{ min==10;}

  function void post_randomize();
    $display("min=%0d", min);
  endfunction
  
endclass



module tab;
  packet pac=new();
  
  initial begin
    repeat(10)
    assert(pac.randomize());
  end
endmodule

