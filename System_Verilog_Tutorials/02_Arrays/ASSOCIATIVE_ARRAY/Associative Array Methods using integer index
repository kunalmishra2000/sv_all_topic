size,delete,exists,first, prev, next,last, num using INTEGER INDEX


module tab;
  int a[int];
  int b[string];
  
  initial begin
    
        //index:element
    int key;

    
    a='{ 0 : 88, 1 : 99, 7 : 1098};
    b='{ "kunal" : 9898, "sakshi" : 7767, "shivam" : 888};
    
    a.first(key);
    $display(" display first index value[%0d]=%0p",key, a[key]);
    
      a.next(key);
    $display(" display next index value[%0d]=%0p",key, a[key]);
    
      a.next(key);
