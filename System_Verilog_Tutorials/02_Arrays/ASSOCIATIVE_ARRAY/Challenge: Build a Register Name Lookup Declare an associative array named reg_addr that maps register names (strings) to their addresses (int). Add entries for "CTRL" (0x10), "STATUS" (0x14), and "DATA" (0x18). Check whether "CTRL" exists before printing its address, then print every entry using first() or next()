  string key;
  initial begin
    reg_addr='{"CTRL" : 10, "STATUS" : 14, "DATA" : 18};
    
    $display("reg_addr=%0p",reg_addr);
    
    if(reg_addr.exists("CTRL"))
      
         $display("CTRL is at 0x%0h", reg_addr["CTRL"]);
    begin
      

      if(reg_addr.first(key))
    $display("[FIRST_ELEMENT] reg_addr[%s]=%0p",key,reg_addr[key]);

      while(reg_addr.next(key)) //using while print all rest of index and value
    $display("[NEXT_ELEMENT] reg_addr[%s]=%0p",key,reg_addr[key]);
    
    end

    
  end
endmodule
