
// unique when any conditon is not true

module tab;
  
  int x=10;
  
  initial begin
    
    unique if(x==3)
      $display("x=%0d", x);
    else if (x==5)
            $display("x=%0d", x);
    else if(x==4)
            $display("x=%0d", x);

    else 
      $display("[not any condition is true] x=%0d", x);
  end

 endmodule
