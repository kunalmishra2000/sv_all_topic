

//Example #1: Single dimensional Arrays


module tab;
  int a[5];
  int sum;
  int sum_even;
  int sum_odd;
  initial begin
    
    a='{1,2,3,4,5};
    
//     foreach(a[i])begin
//       $display("a=%0p", a);
//     end
    
    //sum of all value inside index
    
    foreach(a[i])begin
      sum +=a[i];
      

      
  end
          $display(" sum of all value inside index =%0p", sum);

    
        //sum of all even index value  
    
    foreach(a[i])begin
      if(i%2==0)begin
      sum_even +=a[i];
      
      end

      
  end
                $display(" sum of all even index value  =%0p", sum_even);

    
            //sum of all odd index value  
    
    foreach(a[i])begin
      if(i%2!=0)begin
      sum_odd +=a[i];
      
      end
      
  end
    $display(" sum of all odd index value  =%0p", sum_odd);

  end
endmodule
