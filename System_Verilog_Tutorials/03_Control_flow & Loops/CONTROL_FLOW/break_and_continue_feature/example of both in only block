//SystemVerilog 'break' and 'continue'

//break example
module tab;
  
  
  initial begin
    for(int i=0; i<10; i++)begin
      $display("i=%0d",i);
      if(i==5)begin
        $display("break apply");
        break ;
      end
      
    end
  end
endmodule
    


//break example
module tab1;
  
  initial begin
    for(int i=0; i<10; i++)begin
          //    $display("[continue] i=%0d",i);
      if(i==5)
        //$display("continue apply");
        continue ;
            $display("[continue] i=%0d",i);

      
      
    end
  end
endmodule
    
