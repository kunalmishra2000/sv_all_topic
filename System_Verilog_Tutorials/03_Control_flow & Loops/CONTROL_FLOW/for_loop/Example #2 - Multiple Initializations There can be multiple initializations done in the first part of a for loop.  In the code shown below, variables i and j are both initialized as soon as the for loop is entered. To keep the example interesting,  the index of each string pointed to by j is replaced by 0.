//
/* 
Example #2 - Multiple Initializations
There can be multiple initializations done in the first part of a for loop. 
In the code shown below, variables i and j are both initialized as soon as the for loop is entered. To keep the example interesting, 
the index of each string pointed to by j is replaced by 0.
*/

// replace all string element 2nd index with "o"
module tab;
  string fruit[5];
  int j=2; // it's use to replace index of all strin element with "o"
  initial begin
    
    fruit='{"apple", "mango", "orange", "pear", "pineapple"};
    
    for(int i=0; i<$size(fruit); i++)begin
      fruit[i][j]="o";
      
      $display("fruit[%0d]=%0p %0dth index replaced by 0", i, fruit[i],j);
      
    end
  end
endmodule
