       encoder =4'b1000;
        #1;
        $display("encoder=%b valid=%b output=%b", encoder,valid, out);
    // Direct_test_case 3
        encoder =4'b0100;
        #1;
        $display("encoder=%b valid=%b output=%b", encoder,valid, out);
    // Direct_test_case 4
        encoder =4'b0010;
        #1;
        $display("encoder=%b valid=%b output=%b", encoder,valid, out);
    // Direct_test_case 5
        encoder =4'b0001;
        #1;
        $display("encoder=%b valid=%b output=%b", encoder,valid, out);
    // Direct_test_case 6
        encoder =4'b1100;
