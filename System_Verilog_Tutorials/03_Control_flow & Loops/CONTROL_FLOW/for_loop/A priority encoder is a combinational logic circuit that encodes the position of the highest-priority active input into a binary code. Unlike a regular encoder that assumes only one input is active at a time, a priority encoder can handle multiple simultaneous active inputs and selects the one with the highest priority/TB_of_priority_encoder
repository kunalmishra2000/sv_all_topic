module tab;
  parameter width=4;
  
  logic [width-1:0] encoder;
  logic [$clog2(width)-1:0] out;
  logic valid;
  
  des#(.width(width)) d( .encoder(encoder), .valid(valid), .out(out));
  
  
  initial begin
    
    //using loop generate testcase for only single input high at a time
    for( int i=0 ; i<width; i++)begin
      encoder  =1<<i; //using shifting method to shift 1 bit base one i (how many time need to shift)
      #5;
      $display("[oop generate testcase] encoder=%b valid=%b output=%b", encoder,valid, out);
      
    end
 
  $display("=== Priority Encoder Testbench ===");
  
    // Direct_test_case 1 (initial test case check default case)
    
      encoder =4'b0000;
        #1;
      $display("encoder=%b valid=%b output=%b", encoder,valid, out);
