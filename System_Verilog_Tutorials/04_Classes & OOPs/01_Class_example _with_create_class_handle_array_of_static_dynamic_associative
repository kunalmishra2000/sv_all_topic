class myPacket;
	bit [2:0]  header;
	bit        encode;
	bit [2:0]  mode;
	bit [7:0]  data;
	bit        stop;
  int index;
  string name;

  function new (bit [2:0] header = 3'h1, bit [2:0] mode = 5, string name, int index);
		this.header = header;
		this.encode = 0;
		this.mode   = mode;
		this.stop   = 1;
        this.name =name;
        this.index=index;
	endfunction

	function void display ();
      $display ("[NAME=%s][INDEX=%0d] Header = 0x%0h, Encode = %0b, Mode = 0x%0h, Stop = %0b",
		           this.name, this.index,this.header, this.encode, this.mode, this.stop);
	endfunction
endclass
