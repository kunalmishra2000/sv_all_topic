/*
Challenge: A Parameterized Fixed-Size Buffer
Write a class Buffer #(type T = int, int depth = 4) with a property data declared as an array of depth elements of type T (T data[depth];). Instantiate it twice: once with the defaults, and once overriding both T to byte and depth to 2. Print $bits(data) for each


*/


class buffer#(type t = int , int depth=4);
  t data[depth];
 
  
  
virtual  function void display();
  $display("[base class] address_size=%0p",$bits(data));
  endfunction
  
endclass


module tab;
//Instantiate it twice: once with the defaults, and once overriding both T to byte and depth to 2
  
  //Default print
  buffer b;
  
  
  buffer #( byte, 2) b1;
  
  initial begin
    
    b=new();
  b.display();

    b1=new();
      b1.display();

    

 
  end
endmodule



