


/*
Challenge: Combine Both Kinds of Constant
Write a class Transaction with a global constant static const int MAX_ID = 100; and an instance constant const int id;. In the constructor, accept a requested_id argument, and assign id to whichever is smaller: requested_id or MAX_ID. Create two objects — one with a requested ID under the limit, one over it — and display both.
*/



class packet;
 const int max_id =100; //global id
  const int id ; // inst id
  
  
  function new(int requested_id);
       id = (requested_id > max_id) ? max_id : requested_id;

  endfunction
  
  function void dis();
    $display(" use const key MAX_ID=%0d   ID=%0d", max_id, id);
  endfunction
  
endclass

