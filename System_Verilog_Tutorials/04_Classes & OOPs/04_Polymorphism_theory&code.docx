class base;
  int address;
 
  
  
virtual  function void display();
  $display("address=%0d",address);
  endfunction
  
endclass

class child extends base;
  int  data;
    
  function void display();
    $display("address=%0d data=%0d",address,data);
  endfunction
  
endclass


module tab;
  
  base bas1;
  child chil1;
  
  initial begin
        chil1=new();
    
    chil1.address=010;
    chil1.data =121;
    
    
   // bas1=chil1; //assign chil class into base class
    
        bas1=chil1;
        bas1.display();

    
    // assign base class into child class // it's through error
         //   chil1=bas1;
         // bas1.display();

 
  end
endmodule

--------------------------------------------USING_CASTING_IN_POLYMERPHISM----------------------------------------------------------
//Assign Base Class to Child Class(not allow in poly). how can we solve this issue  using $casting inside module

class base;
  int address;
 
  
  
virtual  function void display();
  $display("address=%0d",address);
  endfunction
  
endclass

class child extends base;
  int  data;
    
  function void display();
    $display("address=%0d data=%0d",address,data);
  endfunction
  
endclass


module tab;
  
  base bas1;
  child chil1,chil2;
  
  initial begin
        chil1=new();
            bas1=new();

    bas1.address=101;
   chil1.address=010;
   chil1.data =121;
 
    
    // assign base class into child class 
            bas1=chil1; //upcasting
    $cast(chil2,bas1); // downcasting
    chil1.display();
    $display( "[chil2 handle] child_data=%0d", chil2.data);

 
  end
endmodule
