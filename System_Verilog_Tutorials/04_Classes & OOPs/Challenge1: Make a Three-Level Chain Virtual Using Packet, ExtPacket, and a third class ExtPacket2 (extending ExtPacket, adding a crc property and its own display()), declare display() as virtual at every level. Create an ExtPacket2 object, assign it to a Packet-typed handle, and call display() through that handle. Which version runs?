/*
Challenge: Make a Three-Level Chain Virtual
Using Packet, ExtPacket, and a third class ExtPacket2 (extending ExtPacket, adding a crc property and its own display()), declare display() as virtual at every level. Create an ExtPacket2 object, assign it to a Packet-typed handle, and call display() through that handle. Which version runs?


*/


class base;
  int address;
 
  
  
virtual  function void display();
  $display("[base class] address=%0d",address);
  endfunction
  
endclass

class child extends base;
  int  crc;
    
 virtual function void display();
  // super.display();
   $display("[child class] address=%0d crc=%0d",address,crc);
  endfunction
  
endclass

class chil2 extends child;
    
  function void display();
   // super.display();
    $display("[GRAND_child class] address=%0d crc=%0d",address,crc);

  endfunction
  
endclass


module tab;
   base bas2;
   chil2 ch2;
   
  
  initial begin
    ch2=new();
    
    bas2=ch2;  //this is point grand child class so display grand child 
    bas2.display();
    

 
  end
endmodule
