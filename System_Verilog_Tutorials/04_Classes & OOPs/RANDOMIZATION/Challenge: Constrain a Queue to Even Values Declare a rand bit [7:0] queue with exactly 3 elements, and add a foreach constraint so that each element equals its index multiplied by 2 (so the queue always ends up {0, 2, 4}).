Challenge: Constrain a Queue to Even Values
Declare a rand bit [7:0] queue with exactly 3 elements, and add a foreach constraint so that each element equals its index multiplied by 2 (so the queue always ends up {0, 2, 4}).
  
  
  class Packet;
  rand bit [7:0] data_q [$];

  constraint c_size { data_q.size() == 3; }

  constraint c_val {
    foreach (data_q[i])
      data_q[i] == i * 2;
  }
endclass

module tb;
  Packet pkt;

  initial begin
    pkt = new();
    pkt.randomize();
    $display("data_q = %p", pkt.data_q);
  end
endmodule
